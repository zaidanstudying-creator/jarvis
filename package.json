{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "test:live": "tsx scripts/live.ts",
    "test:desktop": "npm run build && electron . --smoke-test --ozone-platform=headless --disable-gpu --no-sandbox",
    "format": "prettier --write src tests scripts vite.config.ts tsconfig.json package.json docs README.md",
    "package:mac": "npm run build && tsx scripts/package-macos.ts"
  },
  "main": "dist-electron/main.cjs",
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "fish-audio": "^0.1.0",
    "groq-sdk": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
